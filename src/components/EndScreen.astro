---
import '../styles/end.css'
import { COPY, NAME, type Lang } from '../lib/copy'
import { KI_SYNDIKAT_URL, CONTACT_EMAIL } from '../lib/site'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const c = COPY[lang]
---

<main id="end">
  <header class="who x" id="who"><h1>{NAME}</h1><p>{c.role}</p></header>
  <button type="button" class="rp x" id="rp" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.4 12.6a7.5 7.5 0 1 1-2.3-6.1M17.6 3.4v3.7h-3.7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg><span>{c.replay}</span></button>
  <p class="st x" id="st"><i id="dot"></i><span id="sw">live</span><span id="sb"><i></i></span><b>v47</b></p>
  <p class="cp" id="cp"><span class="a x" id="aL">{c.line[0]}</span> <span class="b x" id="bL">{c.line[1]}</span></p>
  <ul class="ln">
    <li class="x"><a href={c.cwa}>codewithagents.de</a><span class="h">{c.hints[0]}</span></li>
    <li class="x"><a href={KI_SYNDIKAT_URL}>ki-syndikat.de</a><span class="h">{c.hints[1]}</span></li>
    <li class="x"><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a><span class="h">{c.hints[2]}</span></li>
  </ul>
  <footer class="ft x" id="ft">
    <span><a href="/impressum/">Impressum</a><span class="sep" aria-hidden="true">·</span><a href="/datenschutz/">Datenschutz</a></span>
    <span class="r"><nav aria-label={c.langNav}><a href="/?end=1" hreflang="de" lang="de" aria-current={lang === 'de' ? 'page' : undefined}>DE</a><span class="sep" aria-hidden="true">·</span><a href="/en/?end=1" hreflang="en" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a></nav></span>
  </footer>
</main>
