---
import BaseLayout from '../layouts/BaseLayout.astro'
import EndScreen from '../components/EndScreen.astro'
import Film from '../components/Film.astro'
import { COPY } from '../lib/copy'

const c = COPY.de
---

<BaseLayout
  lang="de"
  title={c.title}
  description={c.description}
  ogTitle={c.ogTitle}
  ogDescription={c.ogDescription}
  path="/"
  film
>
  <EndScreen lang="de" />
  <Film lang="de" />
</BaseLayout>
