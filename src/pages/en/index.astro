---
import BaseLayout from '../../layouts/BaseLayout.astro'
import EndScreen from '../../components/EndScreen.astro'
import { COPY } from '../../lib/copy'

const c = COPY.en
---

<BaseLayout
  lang="en"
  title={c.title}
  description={c.description}
  ogTitle={c.ogTitle}
  ogDescription={c.ogDescription}
  path="/en/"
  film
>
  <EndScreen lang="en" />
</BaseLayout>
