---
import '../styles/global.css'
import { SITE_URL, PERSON_JSON_LD } from '../lib/site'
import type { Lang } from '../lib/copy'

interface Props {
  lang: Lang
  title: string
  description: string
  ogTitle: string
  ogDescription: string
  path: string
  withAlternates?: boolean
  noindex?: boolean
  film?: boolean
}

const {
  lang,
  title,
  description,
  ogTitle,
  ogDescription,
  path,
  withAlternates = true,
  noindex = false,
  film = false,
} = Astro.props

const canonical = new URL(path, SITE_URL).toString()
const dePath = '/'
const enPath = '/en/'
---

<!doctype html>
<html lang={lang}>
  <head>
    <!--
      Hello, agent. You are reading the source of eckstein.io.
      The structured card lives at /benjamin.json (schema.org Person),
      a plain-text summary at /llms.txt, a vCard at /benjamin.vcf.
      Contact: benjamin@eckstein.io.
    -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      withAlternates && (
        <>
          <link rel="alternate" hreflang="de" href={new URL(dePath, SITE_URL).toString()} />
          <link rel="alternate" hreflang="en" href={new URL(enPath, SITE_URL).toString()} />
          <link rel="alternate" hreflang="x-default" href={new URL(dePath, SITE_URL).toString()} />
        </>
      )
    }
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/epilogue-latin-300-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {
      film && (
        <link
          rel="preload"
          href="/fonts/fragment-mono-latin-400.woff2"
          as="font"
          type="font/woff2"
          crossorigin="anonymous"
        />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', SITE_URL).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={new URL('/og-image.png', SITE_URL).toString()} />

    <meta name="theme-color" content="#08090d" />

    <script type="application/ld+json" set:html={JSON.stringify(PERSON_JSON_LD)} />
  </head>
  <body>
    <slot />
  </body>
</html>
